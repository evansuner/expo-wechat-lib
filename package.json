{
  "name": "expo-wechat-lib",
  "version": "0.3.3",
  "description": "A Expo Module for supporting Wechat APIs on Android and iOS",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "scripts": {
    "build": "expo-module build",
    "clean": "expo-module clean",
    "lint": "expo-module lint",
    "test": "node --test tests/*.test.js",
    "prepare": "expo-module prepare",
    "prepublishOnly": "expo-module prepublishOnly",
    "expo-module": "expo-module",
    "open:ios": "open -a \"Xcode\" example/ios",
    "open:android": "open -a \"Android Studio\" example/android"
  },
  "keywords": [
    "react-native",
    "expo",
    "expo-native-wechat",
    "ExpoNativeWechat"
  ],
  "repository": "https://github.com/evansuner/expo-wechat-lib",
  "bugs": {
    "url": "https://github.com/evansuner/expo-wechat-lib/issues"
  },
  "author": "Evan <zhidong.s@outlook.com> (https://github.com/evansuner)",
  "license": "MIT",
  "homepage": "https://github.com/evansuner/expo-wechat-lib#readme",
  "dependencies": {},
  "devDependencies": {
    "expo-module-scripts": "^56.0.3",
    "expo-modules-core": "~58.0.22",
    "@types/react": "~19.3.0",
    "expo": "~58.0.14",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2"
  },
  "peerDependencies": {
    "expo": ">=58.0.0 <59.0.0",
    "react": ">=19.3.0 <20.0.0",
    "react-native": ">=0.88.0 <0.89.0"
  },
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || ^26.0.0 || >=27.0.0"
  },
  "files": [
    "build",
    "src",
    "ios/*.h",
    "ios/*.m",
    "ios/*.swift",
    "ios/*.podspec",
    "android/build.gradle",
    "android/src/main",
    "app.plugin.js",
    "expo-module.config.json"
  ]
}
